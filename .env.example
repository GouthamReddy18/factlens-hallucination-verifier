# FactLens Configuration Environment Variables
# Offline rule-based syntactic mode runs 100% on CPU without requiring any API keys.
# Optional LLM API Keys for LLM-based claim decomposition mode:

FACTLENS_LLM_PROVIDER=gemini       # Options: gemini, openai, groq
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Model overrides (optional)
FACTLENS_RETRIEVER_MODEL=sentence-transformers/all-MiniLM-L6-v2
FACTLENS_NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
